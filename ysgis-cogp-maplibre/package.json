{
  "name": "ysgis-cogp-maplibre",
  "version": "0.0.1",
  "description": "MapLibre GL JS vector tile adapter for Cloud Optimized GeoParquet.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node ../scripts/vite-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm-zstd": "1.15.0",
    "ysgis-cogp-core": "workspace:*"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.0.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "maplibre-gl": "6.19.0",
    "pbf": "5.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
