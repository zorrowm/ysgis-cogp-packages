{
  "name": "ysgis-cogp-packages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "ysgis-cogp-core",
    "ysgis-cogp-openlayers",
    "ysgis-cogp-cesium",
    "ysgis-cogp-maplibre",
    "ysgis-cogp-mars3d"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:publish": "pnpm build && node scripts/publish-packages.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "vite --host 127.0.0.1",
    "build:examples": "vite build",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:production": "node scripts/browser-test.mjs --production",
    "test:packages": "node scripts/package-test.mjs"
  },
  "devDependencies": {
    "@turf/turf": "7.4.0",
    "cesium": "^1.147.0",
    "comlink": "4.4.2",
    "maplibre-gl": "6.19.0",
    "mars3d": "^3.12.1",
    "mars3d-cesium": "1.147.0",
    "ol": "^10.11.0",
    "playwright": "^1.65.1",
    "vite": "^8.3.8",
    "vite-plugin-bundle-obfuscator": "1.14.0",
    "vite-plugin-comlink": "5.3.0",
    "ysgis-cogp-cesium": "workspace:*",
    "ysgis-cogp-core": "workspace:*",
    "ysgis-cogp-maplibre": "workspace:*",
    "ysgis-cogp-mars3d": "workspace:*",
    "ysgis-cogp-openlayers": "workspace:*"
  }
}
