{
  "name": "ysgis-cogp-core",
  "version": "0.0.1",
  "description": "Cloud Optimized GeoParquet reader and cross-engine runtime.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./worker-entry": "./dist/worker-entry.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SOURCE_SYNC.md",
    "SOURCE_SYNC.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node ../scripts/vite-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm-zstd": "1.15.0",
    "hyparquet-compressors": "^1.1.1",
    "lineclip": "^2.0.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "apache-arrow": "^21.2.0",
    "pbf": "5.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
