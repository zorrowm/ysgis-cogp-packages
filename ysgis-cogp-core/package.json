{
  "name": "ysgis-cogp-core",
  "version": "0.1.0",
  "description": "Cloud Optimized GeoParquet reader and cross-engine runtime.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./worker-entry": "./dist/worker-entry.js"
  },
  "files": ["dist", "vendor", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "SOURCE_SYNC.md", "SOURCE_SYNC.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "hyparquet-compressors": "^1.1.1",
    "lineclip": "^2.0.0",
    "@hpcc-js/wasm-zstd": "1.15.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@mapbox/vector-tile": "1.3.1",
    "pbf": "3.3.0",
    "apache-arrow": "^21.2.0"
  },
  "engines": { "node": ">=18" }
}
