{
  "name": "ysgis-cogp-cesium",
  "version": "0.0.1",
  "description": "Cloud Optimized GeoParquet data source for CesiumJS.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node ../scripts/vite-package-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ysgis-cogp-core": "workspace:*"
  },
  "peerDependencies": {
    "cesium": "^1.147.0"
  },
  "devDependencies": {
    "cesium": "^1.138.0",
    "typescript": "^5.6.0"
  }
}
